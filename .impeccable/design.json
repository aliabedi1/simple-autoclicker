      "kind": "button",
      "description": "Primary Button from the implemented workspace.",
      "html": "<button class=\"ds-primary\">Start clicking</button>",
      "css": ".ds-primary{font-family:var(--font-sans);font-size:14px;font-weight:500;display:inline-flex;align-items:center;justify-content:center;border-radius:var(--radius);height:32px;padding:0 10px;cursor:pointer;transition:all 150ms cubic-bezier(.4,0,.2,1);background:var(--primary);color:var(--primary-foreground);border:1px solid transparent}.ds-primary:hover{background:color-mix(in oklch,var(--primary) 80%,transparent)}.ds-primary:active{transform:translateY(1px)}.ds-primary:focus-visible{outline:none;border-color:var(--ring);box-shadow:0 0 0 3px color-mix(in oklch,var(--ring) 50%,transparent)}",
