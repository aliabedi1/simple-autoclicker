  "narrative": {
    "northStar": "Operate",
    "overview": "A task-focused desktop control surface: precise, calm, and readable while a run is active. The pointer-and-clock identity is retained; blue connects the primary action, focus, and run indicator. Controls use the existing shadcn/ui Radix Nova vocabulary with locally hosted Geist.\n\nThe interface follows the system appearance by default and offers explicit light and dark choices. Semantic color roles change together, keeping the same visual hierarchy across both appearances.",
    "keyCharacteristics": [
      "Blue primary actions and focus treatment.",
      "Compact semantic controls with explicit labels.",
      "Flat, bordered surfaces and restrained tonal layering.",
      "Responsive setup and schedule panels with a separate run strip."
    ],
    "rules": [
      {
        "name": "Semantic Theme",
        "body": "Use semantic CSS variables for every surface and state so system, light, and dark appearances remain coherent.",
        "section": "colors"
      },
